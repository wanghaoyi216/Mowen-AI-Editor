APP_NAME=Novel AI Editor API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DATABASE_URL=mysql+aiomysql://novel_ai:novel_ai_password@mysql:3306/novel_ai_editor?charset=utf8mb4
REDIS_URL=redis://localhost:6379/0

# ⚠️ 必填：JWT 签名密钥（生产必须替换）
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-super-secret-key-here-change-me

# AI 模型配置（NVIDIA NIM 端点，OpenAI 兼容协议）
# ⚠️ 必填：NVIDIA_API_KEY 必须是 nvapi- 开头的 token
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_PRIMARY_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b,minimaxai/minimax-m2.7,nvidia/llama-3.1-nemotron-70b-instruct,meta/llama-3.1-70b-instruct
CREATOR_MODEL=nvidia/nemotron-3-ultra-550b-a55b
CONTROLLER_MODEL=minimaxai/minimax-m2.7
EMBEDDING_MODEL=nvidia/embed-qa-4
NVIDIA_ENABLE_THINKING=true
NVIDIA_REASONING_BUDGET=16384
NVIDIA_TOP_P=0.95
NVIDIA_MAX_OUTPUT_TOKENS=32768
NVIDIA_PRIMARY_REQUEST_TIMEOUT_SECONDS=600.0
NVIDIA_FALLBACK_REQUEST_TIMEOUT_SECONDS=60.0

# 可选：未配置时不阻断任务，相关工具会跳过
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# Neo4j 图数据库（Docker Compose 中已配置 bolt://neo4j:7687）
NEO4J_URI=bolt://neo4j:7687
NEO4J_DATABASE=neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=novel_ai_password

# API 速率限制（每分钟调用次数）
RATE_LIMIT_CALLS_PER_MINUTE=40
